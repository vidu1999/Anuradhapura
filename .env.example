# Server-only. Put your own Gemini API key in .env.local; never expose it to the browser.
GEMINI_API_KEY=
# AI guide uses OpenRouter. The default free router selects from currently available free models.
OPENROUTER_API_KEY=
OPENROUTER_GUIDE_MODEL=openrouter/free
# Image generation is a separate, potentially paid OpenRouter request.
OPENROUTER_IMAGE_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
